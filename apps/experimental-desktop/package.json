{
	"name": "@repo/experimental-desktop",
	"version": "0.0.0",
	"description": "Standalone Electron shell for desktop experiments.",
	"author": "Rakesh",
	"private": true,
	"type": "module",
	"main": "./out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"package": "electron-builder --config electron-builder.config.ts",
		"package:mac": "electron-builder --mac --config electron-builder.config.ts",
		"package:win": "electron-builder --win --config electron-builder.config.ts",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@tabler/icons-react": "^3.44.0",
		"@tailwindcss/vite": "^4.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"electron-window-state": "^5.0.3",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"shadcn": "^4.11.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@repo/tsconfig": "workspace:*",
		"@types/node": "^24.10.4",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"electron": "^42.4.1",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"typescript": "5.9.3",
		"vite": "^7.3.5"
	}
}
