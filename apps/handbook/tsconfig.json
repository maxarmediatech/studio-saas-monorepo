{
	"extends": "@repo/tsconfig/nextjs.json",
	"compilerOptions": {
		"baseUrl": ".",
		"plugins": [{ "name": "next" }],
		"paths": {
			"@/*": ["./*"],
			"@/.source/*": ["./.source/*"]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"**/*.mdx",
		".next/types/**/*.ts",
		".source/**/*.ts"
	],
	"exclude": ["node_modules"]
}
