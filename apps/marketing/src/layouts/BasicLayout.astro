---
import SiteLayout from '@/layouts/SiteLayout.astro';

const { frontmatter, title, description } = Astro.props;
const pageTitle = frontmatter?.title ?? title;
const pageDescription = frontmatter?.description ?? description ?? `${pageTitle} for Stuwiz.`;
---

<SiteLayout title={`${pageTitle} | Stuwiz`} description={pageDescription}>
  <section class="mx-auto max-w-2xl px-6 pt-[150px] pb-24">
    <article class="prose prose-lg prose-headings:font-display prose-headings:tracking-tight">
      <slot />
    </article>
  </section>
</SiteLayout>
