---
import Icon from './Icon.astro';
import { links, plans } from '@/data/site';

interface Props {
  /** The pricing page uses this as its h1. */
  headingTag?: 'h1' | 'h2';
}

const { headingTag: Heading = 'h2' } = Astro.props;
---

<section id="pricing" class="relative py-24">
  <div class="mx-auto max-w-[1200px] px-6">
    <div class="text-center">
      <div class="reveal"><span class="badge-pill"><Icon name="db" size={14} /> Pricing</span></div>
      <Heading class="reveal display-h2 mt-6 text-ink" style="transition-delay: 0.18s">
        Plans built for photography studios
      </Heading>
      <p class="reveal body-copy mx-auto mt-4 max-w-[480px]" style="transition-delay: 0.26s">
        Monthly or yearly billing. Prices are shown when you sign up, and they include taxes.
      </p>
    </div>
    <div class="mx-auto mt-12 grid max-w-[820px] gap-6 md:grid-cols-2">
      {
        plans.map((plan, index) => {
          const featured = index === plans.length - 1;
          return (
            <div class="reveal" style={`transition-delay: ${0.1 + index * 0.1}s`}>
              <div
                class:list={[
                  'relative h-full rounded-2xl p-8',
                  featured ? 'border-2 border-ink bg-paper' : 'border border-line bg-paper',
                ]}
              >
                {featured && (
                  <span class="absolute -right-[2px] -top-[2px] rounded-bl-xl rounded-tr-2xl bg-royal px-4 py-2 text-[11px] font-semibold tracking-wide text-white">
                    AUTOMATION
                  </span>
                )}
                <h3 class="text-[22px] font-semibold tracking-tight text-ink">{plan.name}</h3>
                <p class="body-copy mt-2 max-w-[300px] !text-[15px]">{plan.blurb}</p>
                <a
                  href={links.signup}
                  class:list={[
                    'mt-7 flex w-full justify-center rounded-full py-3.5 text-[15px] font-medium transition-all duration-300',
                    featured
                      ? 'bg-[#0d0402] text-white hover:bg-[#2a1a14]'
                      : 'border border-[#d4d4d8] text-ink hover:border-ink',
                  ]}
                >
                  Get started
                </a>
                <p class="mt-7 text-[14.5px] font-semibold text-ink">What you get:</p>
                <ul class="mt-4 flex flex-col gap-3">
                  {plan.features.map((feature) => (
                    <li class="flex items-start gap-2.5 text-[15px] text-ink">
                      <span class="mt-[7px] h-2.5 w-2.5 shrink-0 rounded-full bg-royal" />
                      {feature}
                    </li>
                  ))}
                  {plan.soon.map((feature) => (
                    <li class="flex items-start gap-2.5 text-[15px] text-mist">
                      <span class="mt-[7px] h-2.5 w-2.5 shrink-0 rounded-full bg-[#c7c7cc]" />
                      {feature} (coming soon)
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
