---
import Icon from './Icon.astro';
import ProductFrame from './ProductFrame.astro';
import { tools } from '@/data/site';
---

<section id="product" class="relative py-24">
  <div class="mx-auto max-w-[1200px] px-6">
    <div class="grid gap-14 lg:grid-cols-[380px_1fr]">
      <div>
        <div class="lg:sticky lg:top-32">
          <div class="reveal"><span class="badge-pill"><Icon name="rocket" size={14} /> The product</span></div>
          <h2 class="reveal display-h2 mt-6 max-w-[360px] text-ink" style="transition-delay: 0.18s">
            One booking holds the whole wedding
          </h2>
          <div class="mt-10 hidden flex-col gap-6 lg:flex">
            {
              tools.map((tool, index) => (
                <button
                  type="button"
                  data-tool-target={tool.id}
                  class:list={[
                    'border-l-2 pl-4 text-left text-[19px] font-medium transition-colors duration-300 hover:text-royal',
                    index === 0 ? 'border-royal text-royal' : 'border-transparent text-ink',
                  ]}
                >
                  {tool.label}
                </button>
              ))
            }
          </div>
        </div>
      </div>
      <div class="flex min-w-0 flex-col">
        {
          tools.map((tool, index) => (
            <div data-tool-panel={tool.id} class={index > 0 ? 'mt-12 border-t border-line pt-12' : ''}>
              <div class="reveal">
                <h3 class="display-h3 text-ink">{tool.label}</h3>
                <p class="body-copy mt-3 max-w-[520px]">{tool.copy}</p>
                <ProductFrame class="mt-7" src={tool.image} srcSm={tool.imageSm} alt={tool.alt} />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
