---
import Icon from './Icon.astro';
import { screens } from '@/data/site';
---

<section class="relative py-24">
  <div class="mx-auto max-w-[1200px] px-6">
    <div class="text-center">
      <div class="reveal"><span class="badge-pill"><Icon name="scissors" size={14} /> Clients and crew</span></div>
      <h2 class="reveal display-h2 mt-6 text-ink" style="transition-delay: 0.18s">
        Your couples, your crew, your work
      </h2>
      <p class="reveal body-copy mx-auto mt-4 max-w-[460px]" style="transition-delay: 0.26s">
        Client records, crew access and each deliverable's workflow, a click away from the booking.
      </p>
    </div>
    <div class="reveal mt-10 flex flex-wrap justify-center gap-4" role="tablist" style="transition-delay: 0.3s">
      {
        screens.map((screen, index) => (
          <button
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            data-screen-tab={String(index)}
            data-color={screen.color}
            class:list={[
              'flex items-center gap-2.5 rounded-full border border-line bg-white px-5 py-2.5 text-[15px] font-medium text-ink transition-all duration-300 hover:border-[#d4d4d8]',
              index === 0 && 'shadow-sm',
            ]}
            style={index === 0 ? `border-color: ${screen.color}` : undefined}
          >
            <span
              class="flex h-6 w-6 items-center justify-center rounded-full text-[11px] text-white"
              style={`background: ${screen.color}`}
            >
              {screen.glyph}
            </span>
            {screen.label}
          </button>
        ))
      }
    </div>
    <div
      class="reveal mx-auto mt-10 max-w-[900px] rounded-[24px] border border-line bg-paper p-4 shadow-[0_24px_50px_-24px_rgba(24,24,24,0.18)]"
    >
      {
        screens.map((screen, index) => (
          <div data-screen-panel={String(index)} hidden={index !== 0}>
            <img
              src={screen.image}
              alt={screen.alt}
              width="1160"
              height="749"
              loading="lazy"
              decoding="async"
              class="block h-auto w-full rounded-xl border border-line"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
