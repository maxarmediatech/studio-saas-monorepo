---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { links, nav } from '@/data/site';
---

<header class="absolute left-1/2 top-4 z-40 w-[min(960px,calc(100%-32px))] -translate-x-1/2">
  <div
    class="flex items-center justify-between rounded-full border border-line bg-[#fafafa]/90 py-2.5 pl-6 pr-2.5 shadow-[0_8px_30px_rgba(0,0,0,0.05)] backdrop-blur-md"
  >
    <a href="/" aria-label="Stuwiz home" class="flex items-center">
      <Logo height={28} />
    </a>
    <nav aria-label="Main" class="hidden items-center gap-8 text-[15px] font-medium text-ink md:flex">
      {nav.map((item) => <a href={item.href} class="transition hover:text-royal">{item.label}</a>)}
    </nav>
    <div class="flex items-center gap-3 sm:gap-6">
      <a href={links.login} class="hidden text-[15px] font-medium text-ink transition hover:text-royal sm:block">
        Log in
      </a>
      <a href={links.signup} class="btn-dark !px-6 !py-3 text-[14px]">Get started</a>
      <details class="mobile-menu relative md:hidden">
        <summary
          class="flex h-10 w-10 items-center justify-center rounded-full border border-line bg-white text-ink"
          aria-label="Open menu"
        >
          <Icon name="menu" size={18} />
        </summary>
        <div
          class="absolute right-0 top-12 flex w-52 flex-col gap-1 rounded-2xl border border-line bg-white p-3 text-[15px] font-medium shadow-xl"
        >
          {
            nav.map((item) => (
              <a href={item.href} class="rounded-lg px-3 py-2 hover:bg-paper">
                {item.label}
              </a>
            ))
          }
          <a href={links.login} class="rounded-lg px-3 py-2 hover:bg-paper">Log in</a>
        </div>
      </details>
    </div>
  </div>
</header>
