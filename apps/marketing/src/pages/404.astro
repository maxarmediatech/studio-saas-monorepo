---
import SiteLayout from '@/layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found | Stuwiz" description="Sorry, the page you're looking for doesn't exist." noindex>
  <section class="relative flex min-h-[70vh] flex-col items-center justify-center px-6 pt-[150px] pb-24 text-center">
    <span class="badge-pill">404</span>
    <h1 class="display-hero mt-8 text-ink">Page not found</h1>
    <p class="body-copy mx-auto mt-5 max-w-[460px]">
      The page might have moved, or the address may be wrong.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-4">
      <a href="/" class="btn-dark">Back to home</a>
      <a href="/contact" class="btn-light">Contact us</a>
    </div>
  </section>
</SiteLayout>
