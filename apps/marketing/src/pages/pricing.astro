---
import Faq from '@/components/site/Faq.astro';
import FinalCta from '@/components/site/FinalCta.astro';
import Pricing from '@/components/site/Pricing.astro';
import { faqSchema } from '@/data/schema';
import SiteLayout from '@/layouts/SiteLayout.astro';
---

<SiteLayout
  title="Pricing | Stuwiz"
  description="Stuwiz plans for photography studios in India: Studio Basics for bookings, crew and finance, and Studio Advance for lead replies and follow-ups. Prices include taxes."
  jsonLd={[faqSchema]}
>
  <div class="pt-[110px]">
    <Pricing headingTag="h1" />
  </div>
  <Faq />
  <FinalCta />
</SiteLayout>
