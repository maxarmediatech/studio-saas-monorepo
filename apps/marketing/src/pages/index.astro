---
import Faq from '@/components/site/Faq.astro';
import FinalCta from '@/components/site/FinalCta.astro';
import Hero from '@/components/site/Hero.astro';
import Inside from '@/components/site/Inside.astro';
import ModuleStrip from '@/components/site/ModuleStrip.astro';
import Pricing from '@/components/site/Pricing.astro';
import Screens from '@/components/site/Screens.astro';
import Switches from '@/components/site/Switches.astro';
import Tools from '@/components/site/Tools.astro';
import Why from '@/components/site/Why.astro';
import { faqSchema, organizationSchema, softwareSchema } from '@/data/schema';
import SiteLayout from '@/layouts/SiteLayout.astro';
---

<SiteLayout
  title="Stuwiz: studio management software for wedding and photography studios"
  description="Run every wedding from first quote to final album. Quotations, bookings, shoots, deliverables, crew and payments in one place for photography studios."
  jsonLd={[organizationSchema, softwareSchema, faqSchema]}
>
  <Hero />
  <ModuleStrip />
  <Why />
  <Tools />
  <Inside />
  <Screens />
  <Switches />
  <Pricing />
  <Faq />
  <FinalCta />
</SiteLayout>
