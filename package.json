{
	"name": "stuwiz",
	"private": true,
	"scripts": {
		"build": "dotenv -c -- turbo build --filter=@repo/web...",
		"build:all": "dotenv -c -- turbo build",
		"dev": "dotenv -c -- turbo dev --concurrency 15 --filter=!@repo/whatsapp-bridge --filter=!@repo/whatsapp-db --filter=!@repo/whatsapp-core --filter=!@repo/whatsapp-providers --filter=!@repo/whatsapp-worker",
		"handbook:build": "dotenv -c -- turbo build --filter=@repo/handbook...",
		"handbook:dev": "dotenv -c -- turbo dev --filter=@repo/handbook",
		"handbook:typecheck": "turbo type-check --filter=@repo/handbook",
		"start": "dotenv -c -- turbo start",
		"lint": "biome lint . ",
		"check": "biome check",
		"env:check": "pnpm --filter @repo/env check",
		"clean": "turbo clean",
		"format": "biome format . --write",
		"typecheck": "turbo type-check",
		"db:generate": "pnpm --filter @repo/database generate",
		"db:baseline": "pnpm --filter @repo/database baseline",
		"db:migrate": "pnpm --filter @repo/database migrate",
		"db:push": "pnpm --filter @repo/database push",
		"db:seed": "turbo db:seed",
		"db:studio": "pnpm --filter @repo/database studio",
		"jobs:dev": "pnpm dlx trigger.dev@4.4.5 dev",
		"jobs:deploy": "pnpm dlx trigger.dev@4.4.5 deploy",
		"notifications:deadlines": "pnpm --filter @repo/scripts notifications:deadlines",
		"financial:migration-preflight": "pnpm --filter @repo/scripts financial:migration-preflight",
		"calendar:reconcile": "pnpm --filter @repo/scripts calendar:reconcile",
		"submissions:reconcile-parent-review": "pnpm --filter @repo/scripts submissions:reconcile-parent-review",
		"whatsapp:migration-preflight": "pnpm --filter @repo/scripts whatsapp:migration-preflight"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b",
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@repo/tsconfig": "workspace:*",
		"@types/node": "^24.10.4",
		"dotenv-cli": "^11.0.0",
		"turbo": "^2.7.1",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"@repo/auth": "workspace:*",
		"@repo/database": "workspace:*",
		"@repo/whatsapp-outbox": "workspace:*",
		"@trigger.dev/sdk": "4.4.5",
		"zod": "^4.2.1"
	},
	"pnpm": {
		"overrides": {
			"@types/react": "19.2.7",
			"@types/react-dom": "19.2.3"
		}
	}
}
