# ===========================================
# Studio SaaS Monorepo - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# See docs/SETUP.md for detailed setup instructions

# ===================
# REQUIRED
# ===================

# Database - PostgreSQL connection string
# Supports: Local PostgreSQL, PlanetScale, Supabase, Neon, etc.
DATABASE_URL="postgresql://user:password@localhost:5432/studio_saas"

# Authentication secret - Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public URL of your application
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ===================
# AUTHENTICATION
# ===================

# Google OAuth (Optional)
# Setup: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Calendar Integration (Optional)
# Uses a separate OAuth client from login for least-privilege consent.
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# Integration token security (Required if Calendar integration is enabled)
# Generate with: openssl rand -base64 32
INTEGRATIONS_TOKEN_ENCRYPTION_KEY=""
INTEGRATIONS_OAUTH_STATE_SECRET=""

# GitHub OAuth (Optional)
# Setup: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ===================
# EMAIL
# ===================
RESEND_API_KEY=""
EMAIL_FROM_NAME="Stuwiz"
EMAIL_FROM_ADDRESS="noreply@updates.stuwiz.com"
EMAIL_REPLY_TO="hello@stuwiz.com"
# Public URL used inside transactional emails. Set this even when local dev runs on localhost.
EMAIL_BASE_URL="https://app.stuwiz.com"
# Optional dedicated asset host for email images. Falls back to EMAIL_BASE_URL.
EMAIL_ASSET_BASE_URL="https://app.stuwiz.com"

# ===================
# SMS
# ===================

MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_FLOW_CREW_ASSIGNMENT=""

# ===================
# WHATSAPP / META
# ===================

# Meta Developer App ID for Stuwiz embedded signup.
NEXT_PUBLIC_META_APP_ID=""

# WhatsApp Embedded Signup configuration ID from Facebook Login for Business.
NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=""

# Meta Developer App Secret. Keep server-only.
META_APP_SECRET=""

# Graph API version used for embedded signup token exchange and Cloud API calls.
META_GRAPH_VERSION="v22.0"

# Platform webhook verify token for the Stuwiz Meta app webhook.
META_WEBHOOK_VERIFY_TOKEN=""

# Local development fallback account. When these three values are present,
# the app auto-creates/updates a test Cloud API account for the active studio.
WHATSAPP_DEV_ACCOUNT_NAME="WhatsApp test number"
WHATSAPP_DEV_PHONE_NUMBER_ID=""
WHATSAPP_DEV_WABA_ID=""
WHATSAPP_DEV_ACCESS_TOKEN=""
WHATSAPP_DEV_DISPLAY_PHONE_NUMBER=""
WHATSAPP_DEV_API_VERSION="v22.0"

# Trigger.dev background jobs for WhatsApp outbox processing.
TRIGGER_PROJECT_ID="proj_hxsdkcheffosbtemnmwr"
TRIGGER_SECRET_KEY=""

# ===================
# PAYMENTS
# ===================

DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_SECRET=""

# ===================
# PAYMENT CATALOG
# ===================
# Get these from your payment provider after creating products

DODO_PRODUCT_COLLECTION_ID_STUDIO_BASICS=""
DODO_PRODUCT_ID_STUDIO_BASICS_MONTHLY=""
DODO_PRODUCT_ID_STUDIO_BASICS_YEARLY=""

# Optional: set to "0" to disable inline checkout and force full-page redirect
NEXT_PUBLIC_DODO_INLINE_CHECKOUT="1"

# ===================
# STORAGE (S3-Compatible)
# ===================
# Works with: AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO

S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_REGION=""
UPLOADS_BUCKET_NAME="uploads"

# ===================
# ANALYTICS (Optional)
# ===================

# Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""

# Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=""

# Pirsch
NEXT_PUBLIC_PIRSCH_CODE=""

# Plausible
NEXT_PUBLIC_PLAUSIBLE_URL=""

# ===================
# AI (Optional)
# ===================

# OpenAI
OPENAI_API_KEY=""

# ===================
# BUILD OPTIONS
# ===================

# Skip environment validation during build (useful for CI/CD)
# SKIP_ENV_VALIDATION=true
